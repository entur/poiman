{
  "name": "poiman",
  "version": "0.1.0",
  "private": true,
  "description": "POI editor that produces NeTEx XML for the Norwegian event POI feed",
  "type": "module",
  "scripts": {
    "preinstall": "sh scripts/require-bun.sh",
    "dev": "DISABLE_AUTH=true NODE_ENV=development bun --watch src/server/server.ts",
    "build:client": "bun build src/client/main.tsx --outdir dist/client --target browser --minify --sourcemap",
    "build": "bun run build:client",
    "start": "bun src/server/server.ts",
    "test": "bun test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "jose": "^6.2.10",
    "maplibre-gl": "^5.24.0",
    "oidc-client-ts": "^3.5.0",
    "preact": "^10.29.8",
    "react-oidc-context": "^3.3.1"
  },
  "alias": {
    "react": "preact/compat",
    "react-dom": "preact/compat",
    "react/jsx-runtime": "preact/jsx-runtime"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
