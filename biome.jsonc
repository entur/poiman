{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "scripts/**", "*.json"] },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // The editor UI has clickable divs and bare labels that predate the
        // linter. Re-enable once the markup is fixed.
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      },
      "complexity": {
        // HTTP header maps keep string keys, so "Authorization" reads the
        // same as "X-Id-Token" next to it.
        "useLiteralKeys": "off"
      },
      "style": {
        // Selector order in style.css is deliberate.
        "noDescendingSpecificity": "off",
        // noUncheckedIndexedAccess makes `rows[0]!` the idiom in tests, and
        // `?.` there would silently pass instead of failing.
        "noNonNullAssertion": "off"
      }
    }
  }
}
